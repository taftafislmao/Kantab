<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KanTab.ViewModels"
             xmlns:converters="using:KanTab.Converters"
             x:Class="KanTab.Views.StartupView"
             x:DataType="vm:StartupViewModel">
    <Border Background="{StaticResource WindowBackgroundBrush}" Padding="24">
        <Grid RowDefinitions="*,Auto,*" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Brand block with fade/slide entrance -->
            <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Spacing="6" Opacity="0" x:Name="BrandBlock">
                <StackPanel.Styles>
                    <Style Selector="StackPanel">
                        <Setter Property="RenderTransform" Value="translateY(8px)" />
                    </Style>
                </StackPanel.Styles>
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut" />
                    </Transitions>
                </StackPanel.Transitions>
                <TextBlock Text="KanTab" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" LetterSpacing="1" />
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Width="64" HorizontalAlignment="Center" Opacity="0.6" />
            </StackPanel>

            <!-- Middle: indeterminate progress + status -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,20,0,0">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="2" Foreground="{StaticResource AccentBrush}" Background="{StaticResource DividerBrush}" />
                <Rectangle Height="2" IsVisible="{Binding !IsBusy}" Fill="{StaticResource DividerBrush}" Opacity="0.5" />
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center">
                    <TextBlock.Transitions>
                        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
                    </TextBlock.Transitions>
                </TextBlock>
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringIsNotNullOrEmptyConverter.Instance}}" FontSize="11" Foreground="#E5534B" TextWrapping="Wrap" MaxWidth="340" HorizontalAlignment="Center" TextAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding CanRetry}">
                    <Button Content="Retry" Command="{Binding RetryCommand}" Padding="12,4" FontSize="11" MinHeight="26" Background="{StaticResource AccentBrush}" Foreground="White" />
                    <Button Content="Continue offline" Command="{Binding ContinueOfflineCommand}" IsVisible="{Binding CanContinueOffline}" Padding="10,4" FontSize="11" MinHeight="26" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="v1.0.0" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0" />
        </Grid>
    </Border>
</UserControl>
