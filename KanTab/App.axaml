<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KanTab.App"
             xmlns:local="using:KanTab"
             xmlns:converters="using:KanTab.Converters"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:StringIsNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
        <converters:SyncStatusToBrushConverter x:Key="SyncStatusToBrushConverter" />
        <converters:PriorityToBrushConverter x:Key="PriorityToBrushConverter" />
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" />
        <converters:NotePreviewConverter x:Key="NotePreviewConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
