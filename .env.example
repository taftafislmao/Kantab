# Supabase Configuration
# Copy this file to supabase.local.json or set env vars
# Never commit real credentials

SUPABASE_URL=
SUPABASE_ANON_KEY=

# KANTAB variants (also supported)
# KANTAB_SUPABASE_URL=
# KANTAB_SUPABASE_ANON_KEY=

# Web auth base URL for desktop -> browser flow
# KANTAB_AUTH_WEB_URL=http://localhost:5173
